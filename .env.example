# 856-FFCI v3.1 — variables de entorno (configurar en Vercel → Settings → Environment Variables)
# Todas son opcionales.

# Clave de acceso a la API. Si se define, la app exige el encabezado x-ffci-key
# (se captura en la pestaña FUENTES → Clave de acceso).
FFCI_ACCESS_KEY=

# Secreto del cron diario de refresco (Vercel lo envía como Authorization: Bearer …)
CRON_SECRET=

# Vigencia de la caché de listas en horas (por defecto 12)
FFCI_CACHE_TTL_HOURS=12

# URLs alternativas de las listas oficiales (solo si la autoridad cambia la ruta)
OFAC_SDN_URL=
OFAC_ALT_URL=
OFAC_CONS_URL=
OFAC_CONS_ALT_URL=
UN_LIST_URL=
EU_LIST_URL=
