{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/screen.ts": { "memory": 2048, "maxDuration": 60 },
    "api/sources.ts": { "memory": 2048, "maxDuration": 60 },
    "api/cron.ts": { "memory": 2048, "maxDuration": 60 },
    "api/net.ts": { "maxDuration": 60 },
    "api/registry.ts": { "maxDuration": 30 }
  },
  "crons": [{ "path": "/api/cron", "schedule": "15 6 * * *" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}
